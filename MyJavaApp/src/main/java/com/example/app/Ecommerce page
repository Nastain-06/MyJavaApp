import java.awt.*;
import javax.swing.*;

public class EduLifeUI {
    public static void main(String[] args) {
        JFrame frame = new JFrame("EduLife+");
        frame.setSize(1000, 700);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());

        // HEADER
        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(new Color(55, 55, 55));

        // Judul kiri atas
        JLabel title = new JLabel("EduLife+");
        title.setFont(new Font("SansSerif", Font.BOLD, 28));
        title.setForeground(Color.WHITE);
        title.setBorder(BorderFactory.createEmptyBorder(10, 20, 10, 0));
        header.add(title, BorderLayout.WEST);

        // Menu Navigasi Tengah
        JPanel menu = new JPanel();
        menu.setBackground(new Color(51, 51, 51));
        menu.setLayout(new FlowLayout(FlowLayout.CENTER, 20, 15));
        String[] menus = {"Home", "About", "Daily activity", "E-commerce"};

        for (String menuText : menus) {
            JButton btn = new JButton(menuText);
            btn.setFocusPainted(false);
            btn.setBorderPainted(false);
            btn.setContentAreaFilled(false);
            btn.setForeground(Color.WHITE);
            btn.setFont(new Font("SansSerif", Font.PLAIN, 16));

            // Action Listener
            btn.addActionListener(e -> {
                JOptionPane.showMessageDialog(null, "Navigasi ke: " + menuText);
            });

            menu.add(btn);
        }
        header.add(menu, BorderLayout.CENTER);

        frame.add(header, BorderLayout.NORTH);

        // PANEL UTAMA (isi konten kartu)
        JPanel mainPanel = new JPanel(new GridLayout(1, 4, 20, 10));
        mainPanel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));
        mainPanel.setBackground(new Color(230, 220, 200));

        // Tambah 4 kartu paket
        addCard(mainPanel, "Brain Academy", "Kegiatan vidio belajar & latihan soal fisika dasar",
                "Vidio memungkinkan siswa untuk melihat konsep fisika dalam bentuk animasi, simulasi, eksperimen, sehingga lebih mudah dipahami",
                "Rp 50.000", "paket1.jpg");

        addCard(mainPanel, "English academy", "Kursus Bahasa inggris bersama mr.dylan",
                "Menawarkan pengalaman belajar yang unik dan efektif dengan mr.dylan dengan interaksi langsung dengan pengajar asli.",
                "Rp 100.000", "paket2.jpg");

        addCard(mainPanel, "Brain academy center", "Kelas tatap muka + video belajar dan latihan soal",
                "Kelas ini menggabungkan pembelajaran tatap muka langsung dengan video pembelajaran soal dan latihan soal interaktif.",
                "Rp 500.000", "paket3.jpg");

        addCard(mainPanel, "Investmen academy", "Belajar menganalisis instrumen investasi bersama Mr.timothy",
                "Kelas ini dirancang untuk membantu anda memahami berbagai instrumen investasi, bagaimana menganalisisnya dan membuat keputusan investasi yang tepat",
                "Rp 8.000.000", "paket4.jpg");

        frame.add(mainPanel, BorderLayout.CENTER);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }

    // Method untuk menambahkan kartu ke panel
    static void addCard(JPanel container, String category, String title, String description, String price, String imagePath) {
        JPanel card = new JPanel();
        card.setLayout(new BoxLayout(card, BoxLayout.Y_AXIS));
        card.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        card.setBackground(Color.WHITE);
        card.setMaximumSize(new Dimension(220, 600));

        // Gambar (placeholder jika gambar tidak ditemukan)
        JLabel imgLabel;
        try {
            ImageIcon icon = new ImageIcon(imagePath);
            Image img = icon.getImage().getScaledInstance(200, 120, Image.SCALE_SMOOTH);
            imgLabel = new JLabel(new ImageIcon(img));
        } catch (Exception e) {
            imgLabel = new JLabel("[Gambar]");
            imgLabel.setHorizontalAlignment(JLabel.CENTER);
        }

        JLabel catLabel = new JLabel(category);
        catLabel.setFont(new Font("SansSerif", Font.BOLD, 14));

        JLabel titleLabel = new JLabel("<html><b>" + title + "</b></html>");
        titleLabel.setFont(new Font("SansSerif", Font.PLAIN, 13));
        titleLabel.setBorder(BorderFactory.createEmptyBorder(5, 0, 5, 0));

        JTextArea descArea = new JTextArea(description);
        descArea.setLineWrap(true);
        descArea.setWrapStyleWord(true);
        descArea.setEditable(false);
        descArea.setFont(new Font("SansSerif", Font.PLAIN, 12));
        descArea.setBackground(Color.WHITE);

        JLabel priceLabel = new JLabel("<html><b>" + price + "</b>/bulan</html>");
        priceLabel.setFont(new Font("SansSerif", Font.PLAIN, 14));
        priceLabel.setForeground(Color.BLACK);

        JButton beliBtn = new JButton("Beli Paket");
        beliBtn.setBackground(new Color(255, 153, 0));
        beliBtn.setForeground(Color.WHITE);

        // Susun komponen dalam kartu
        card.add(imgLabel);
        card.add(Box.createVerticalStrut(5));
        card.add(catLabel);
        card.add(titleLabel);
        card.add(descArea);
        card.add(Box.createVerticalStrut(5));
        card.add(priceLabel);
        card.add(beliBtn);

        container.add(card);
    }
}

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.app.EcommerceController"
            prefWidth="400" prefHeight="500"
            stylesheets="@css/style.css">

    <VBox alignment="CENTER" spacing="20" layoutX="50" layoutY="50" prefWidth="300">
        <Label text="E-Commerce" styleClass="title-label" />
        <Label text="Fitur ini akan menampilkan produk dan transaksi." style="-fx-text-fill: white;" />
        <Button text="Kembali ke Home" styleClass="main-button" onAction="#handleBack"/>
    </VBox>
</AnchorPane>
